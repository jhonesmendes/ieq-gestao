# Modelo de .env para produção no aaPanel (Fase 6 do plano de migração).
# Copie para .env no servidor e preencha os valores reais — NUNCA commitar
# este arquivo preenchido no Git.

APP_NAME="IEQ Gestão"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.ieqroo.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Mesmo banco MySQL de produção que o PHP atual já usa — ver
# ieq/.env (DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASS reais) para copiar os
# valores. Não é uma migração de dados, é o mesmo banco, dois backends
# apontando pra ele durante a janela de verificação.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jhones09_eie64z
DB_USERNAME=
DB_PASSWORD=

# Domínio real de produção, sem protocolo/porta.
SANCTUM_STATEFUL_DOMAINS=www.ieqroo.com.br,ieqroo.com.br
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.ieqroo.com.br
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="hello@ieqroo.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
FRONTEND_URL=https://www.ieqroo.com.br

# Credenciais reais do Google Cloud Console — atualizar também a Redirect URI
# autorizada lá para apontar para o domínio de produção (ver checklist no
# DEPLOY.md). Vazio = botão Google fica escondido no front.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.ieqroo.com.br/api/auth/google/callback
